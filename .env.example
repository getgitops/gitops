# Git repository backing GitDB. Cloned into /data/gitdb at startup.
GITDB_REPOSITORY_URL=git@github.com:getgitops/gitops-db-dev.git
GITDB_BRANCH=main

# Local path where the repository is cloned (must be writable)
GITDB_DATA_PATH=/data/gitdb

# Authentication for https remotes. Use a token, or a user/password pair.
# Leave both empty for ssh remotes (deploy key / agent) or public repositories.
GITDB_TOKEN=
GITDB_USERNAME=
GITDB_PASSWORD=

# Commit identity, also written to /data/gitdb/gitdb.manifest.json
GITDB_AUTHOR_NAME=gitops
GITDB_AUTHOR_EMAIL=gitops@getgitops.local

# How often the cluster pulls and pushes GitDB changes (10..86400)
GITDB_SYNC_POLL_SECONDS=60

# Pepper used to hash user passwords and sign sessions
GITDB_ENCRYPTION_KEY="development"
