# Required GitDB configuration
GITDB_REPOSITORY_URL=https://github.com/your-org/your-gitdb-repository.git
GITDB_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Public URL of the app: SvelteKit's CSRF check and the absolute links in emails
ORIGIN=http://localhost:3000

# Optional GitDB configuration
GITDB_BRANCH=main
GITDB_DATA_PATH=./data/gitdb
GITDB_AUTHOR_NAME=gitops
GITDB_AUTHOR_EMAIL=gitops@example.com
GITDB_SYNC_POLL_SECONDS=60

# Optional dedicated key for the vault secret values (AES-256-GCM).
# Falls back to GITDB_ENCRYPTION_KEY. Rotating it makes existing secrets unreadable.
# VAULT_ENCRYPTION_KEY=

# Optional HTTP(S) authentication for the GitDB repository
# GITDB_TOKEN=
# GITDB_USERNAME=
# GITDB_PASSWORD=

# Optional SMTP notifications: invitations, password resets, alerts and access notices.
# Without HOST and FROM no email is sent (alerts are kept, the UI shows a warning).
# Links in emails are built from ORIGIN above; without it emails go out without links.
# For local testing: `docker compose --profile mail up mailpit`, HOST=localhost, PORT=1025,
# then read the emails at http://localhost:8025
# NOTIFICATION_SMTP_HOST=smtp.example.com
# NOTIFICATION_SMTP_PORT=587               # 465 turns TLS on by default
# NOTIFICATION_SMTP_SECURE=false           # force TLS on/off
# NOTIFICATION_SMTP_USER=                  # USER and PASSWORD go together
# NOTIFICATION_SMTP_PASSWORD=
# NOTIFICATION_SMTP_FROM=noreply@example.com
# NOTIFICATION_SMTP_FROM_NAME=GitOps
# NOTIFICATION_SMTP_REJECT_UNAUTHORIZED=true  # only set false for self-signed test servers

# Generic webhook channels only reach public https URLs (no private, loopback, link-local, CGNAT,
# multicast or cloud metadata addresses). Local development only: never enable in production.
# NOTIFICATIONS_WEBHOOK_ALLOW_HTTP=false
# NOTIFICATIONS_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Optional "Add to Slack" for Slack alert channels: users pick the workspace and channel in Slack
# instead of pasting an Incoming Webhook URL. Create the app from GitOps Settings → Slack (prefilled
# manifest, incoming-webhook scope only). Redirect URL: <ORIGIN>/notifications/slack/callback (https)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# The /gitops command of the same app (install the app, link users, connect channels from Slack)
# also needs the app's Signing Secret (Basic Information → App Credentials). Slack sends commands
# to <ORIGIN>/api/slack/commands, so the server must be reachable from the internet (locally: a
# tunnel such as cloudflared or ngrok, with ORIGIN set to the tunnel's https URL)
# SLACK_SIGNING_SECRET=
# To try it locally serve the dev server over https (Slack refuses http redirect URLs):
#   mkdir -p .certs && openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj /CN=localhost \
#     -addext subjectAltName=DNS:localhost -keyout .certs/localhost-key.pem -out .certs/localhost.pem
# then open https://localhost:5173 and register https://localhost:5173/notifications/slack/callback
# DEV_HTTPS=true

# Optional cluster-wide Google sign-in (OpenID Connect). Shown on the login page when both the
# client ID and secret are set. Redirect URI to register in GCP: <ORIGIN>/auth/sso/google/callback
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
# Comma-separated Google Workspace domains allowed to sign in (empty: any verified Google account)
GOOGLE_SSO_ALLOWED_DOMAINS=gigigo.com,example.org
# Sign up unknown Workspace accounts of the allowed domains as cluster users (needs allowed domains)
GOOGLE_SSO_AUTO_PROVISION=


# Git repository backing GitDB. Cloned into /data/gitdb at startup.
GITDB_REPOSITORY_URL=git@github.com:getgitops/gitops-db-dev.git
GITDB_BRANCH=main

# Local path where the repository is cloned (must be writable)
GITDB_DATA_PATH=/data/gitdb

# Authentication for https remotes. Use a token, or a user/password pair.
# Leave both empty for ssh remotes (deploy key / agent) or public repositories.
GITDB_TOKEN=
GITDB_USERNAME=
GITDB_PASSWORD=

# Commit identity, also written to /data/gitdb/gitdb.manifest.json
GITDB_AUTHOR_NAME=gitops
GITDB_AUTHOR_EMAIL=gitops@getgitops.local

# How often the cluster pulls and pushes GitDB changes (10..86400)
GITDB_SYNC_POLL_SECONDS=60

# Pepper used to hash user passwords and sign sessions
GITDB_ENCRYPTION_KEY="development"

# How long the organization events page (/org/<org>/settings/events) keeps events and their
# acknowledgements, e.g. 30d, 12h, 45m (a bare number means seconds). Default: 7d.
# Events live in memory: a restart clears them and each replica keeps its own list.
# GITOPS_EVENTS_EXPIRATION=7d
# Environment this instance runs in; it only picks the favicon (local = green, development = blue,
# production = orange). Default: local under `vite dev`, production otherwise.
# GITOPS_ENVIRONMENT=production

# ─── Monitoring (HTTP uptime monitors) ──────────────────────────────────────
# Monitor configuration lives in the main GitDB. Metrics (incidents, hourly and daily aggregates,
# never one row per check) go to this separate GitDB repository so the main history stays clean
# and the metrics repository can be squashed or recreated. Empty: metrics use the main repository.
# MONITORING_GITDB_REPOSITORY_URL=git@github.com:your-org/gitops-monitoring-db.git
# MONITORING_GITDB_BRANCH=main
# MONITORING_GITDB_DATA_PATH=/data/gitdb-monitoring   # default: <GITDB_DATA_PATH>-monitoring
# MONITORING_GITDB_TOKEN=                             # https token; default: the GITDB_* credentials

# Shared secret of the internal worker API (/api/internal/monitoring/*). Empty: the internal API
# is disabled and only the embedded worker runs checks.
# MONITORING_WORKER_TOKEN=
# Optional comma-separated Host headers allowed on the internal API, e.g. the private hostname
# gitops.railway.internal:3000, so it can't be used through the public domain.
# MONITORING_INTERNAL_HOSTS=

# Run checks inside the server process too (default true). Set false when dedicated workers
# (`bun run worker`, see README) do the work.
# MONITORING_EMBEDDED_WORKER=true
# MONITORING_EMBEDDED_WORKER_CONCURRENCY=20

# Checks may not reach loopback, private, link-local (cloud metadata) or reserved addresses unless
# this is true. Applies to the "Test" button and the embedded worker; dedicated workers read their
# own MONITORING_ALLOW_PRIVATE_TARGETS.
# MONITORING_ALLOW_PRIVATE_TARGETS=false

# One log line per finished check (monitor, method + URL without query, status, HTTP code, latency,
# cause): info when up, warn when degraded or down. Default true; set false to silence it. Applies to
# the embedded worker; dedicated workers read their own MONITORING_CHECK_LOGS.
# MONITORING_CHECK_LOGS=true

# How often the hour in progress is saved (default 300). Up to this much of the hourly counters is
# lost on a crash; incidents are written as soon as they open or close.
# MONITORING_FLUSH_SECONDS=300
# Hourly aggregates are kept this many days, then compacted into one row per day (default 30)
# MONITORING_HOURLY_RETENTION_DAYS=30
# Closed incidents older than this are deleted (default 365)
# MONITORING_INCIDENT_RETENTION_DAYS=365

# ─── CVE feed (/org/<org>/cves, "CVEs por tecnología" tab; docs/adr/0004-cve-feed.md) ─────────
# Follows the CVEs published in public sources (OSV.dev, NVD, CISA KEV, FIRST EPSS) for the
# technologies each organization chooses, and emits cve_feed.* events. OFF by default: with false
# the server makes no external call at all (also not from "Sincronizar ahora").
# CVE_FEED_ENABLED=false
# How often the sources are queried: 30m, 2h, 1d (minimum 15m, default 2h). Several instances
# never sync at once (lease in the feed state).
# CVE_FEED_SYNC_INTERVAL=2h
# Only advisories at or above this severity (critical|high|medium|low), or in CISA KEV, or with an
# EPSS score at or above the threshold, are stored. Default high.
# CVE_FEED_MIN_SEVERITY=high
# CVE_FEED_EPSS_THRESHOLD=0.5
# Advisories not modified for this long are deleted (default 180d): keeps GitDB from growing.
# CVE_FEED_RETENTION=180d
# When a technology starts being followed, the last CVE_FEED_BACKFILL of advisories are loaded
# without emitting events (default 30d).
# CVE_FEED_BACKFILL=30d
# NVD API key (optional; NVD is only queried for technologies looked up by CPE, such as
# PostgreSQL or nginx): raises the rate limit from 5 to 50 requests per 30 s. Without it the first
# backfill of many CPE technologies takes minutes. https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=
# The feed tables (cve_advisories, cve_feed_state, cve_org_matches) change on every sync.
# RECOMMENDED in production: point them to their own repository so the main history stays clean
# and the feed history can be squashed or recreated; empty: the main repository. The watchlists
# (cve_watchlists) always stay in the main one.
# CVE_FEED_GITDB_REPOSITORY_URL=git@github.com:your-org/gitops-cve-feed-db.git
# CVE_FEED_GITDB_BRANCH=main
# CVE_FEED_GITDB_DATA_PATH=/data/gitdb-cve-feed   # default: <GITDB_DATA_PATH>-cve-feed
# CVE_FEED_GITDB_TOKEN=                           # https token; default: the GITDB_* credentials

# --- State IaC (docs/adr/0003-state-iac.md) ---------------------------------------------------
# Backends (buckets) are configured per organization at /org/<org>/settings/state-iac; their
# credentials live encrypted in GitDB (GITDB_ENCRYPTION_KEY), not here. Ambient auth uses the
# server's ADC / Workload Identity (GCS) or AWS credential chain (S3).
# Largest state file read, decompressed, in MB (default 50, max 500). Bigger ones fail cleanly.
# STATE_IAC_MAX_STATE_MB=50
# How long stack listings and states stay cached in memory, in seconds (default 60). Unchanged
# states are reused after that too: the cache is keyed by the object's ETag / generation.
# STATE_IAC_CACHE_SECONDS=60
