{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "paths": {
      "$lib": ["../src/lib"],
      "#lib/*": ["../src/lib/*"],
      "$modules": ["../src/modules"],
      "#modules/*": ["../src/modules/*"],
      "$app/env/private": ["./env-private.ts"]
    }
  }
}
