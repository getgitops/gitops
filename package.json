    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.0.0",
    "husky": "^9.1.0",
    "svelte-eslint-parser": "^0.25.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^4.2.18",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
